NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Use Neon's pooled URL at runtime and the direct URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=900

# Required to send owner invitations. Never commit a real key.
RESEND_API_KEY=
MAIL_FROM=Guesthouse Booking <onboarding@resend.dev>
